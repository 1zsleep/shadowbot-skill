      "helpUrl": "language/zh-cn/指令文档/数据处理/日期时间/获取时间间隔.html",
      "inputs": [
        {
          "name": "begin_datetime",
          "label": "开始时间",
          "required": false,
          "tips": "输入开始时间。若日期是文本，只支持常用格式，如：2020-02-02、2020/02/02 02:02:02、2020年2月2日 2时2分2秒等",
