      "comment": "获取%begin_datetime%到%end_datetime%间隔的%unit%数，将结果保存至%datetime_difference%",
      "handlers": [
        {
          "name": "ShadowBot.Runtime.Development.Blockly.Handlers.Datetime.DifferenceHandler"
