          "editor": {
            "kind": "textbox",
            "placeholder": "日期时间对象或文本。若空，则为系统的当前时间"
          }
        },
        {
          "name": "end_datetime",
          "label": "结束时间",
          "required": false,
          "tips": "输入结束时间。若日期是文本，只支持常用格式，如：2020-02-02、2020/02/02 02:02:02、2020年2月2日 2时2分2秒等",
          "type": "datetime",
          "editor": {
            "kind": "textbox",
            "placeholder": "日期时间对象或文本。若空，则为系统的当前时间"
          }
        },
        {
          "name": "unit",
          "label": "时间间隔单位",
          "required": true,
          "default": "10:second",
          "defaultDisplay": "秒",
          "tips": "选择时间间隔的时间单位",
          "type": "str",
          "editor": {
            "kind": "select",
            "options": [
              {
                "display": "秒",
                "value": "second"
              },
              {
                "display": "分钟",
                "value": "minute"
              },
              {
                "display": "小时",
                "value": "hour"
              },
              {
                "display": "天",
                "value": "day"
              }
            ]
          }
        }
