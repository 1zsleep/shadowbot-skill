          "default": "10:common",
          "defaultDisplay": "通用识别",
          "tips": "选择一种识别模式",
          "type": "str",
          "editor": {
            "kind": "select",
            "options": [
              {
                "display": "通用模式",
                "value": "common"
              },
              {
                "display": "高精度模式",
                "value": "accurate"
              }
            ]
          }
        },
        {
          "name": "pump_type",
